# ---------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored, never commit it.
# Quarkus dev mode reads this file automatically; docker compose reads it
# for any variable referenced with ${...} in the compose files.
# ---------------------------------------------------------------------

# PostgreSQL 16 - used by docker compose to initialise the database
POSTGRES_DB=email_app
POSTGRES_USER=email_user
POSTGRES_PASSWORD=email_password

# JDBC settings consumed by the application.
# Credentials belong in DB_USERNAME / DB_PASSWORD, never inside the URL,
# and the port is mandatory. For a managed database add ?sslmode=require.
# Inside docker compose the host is the service name: `postgres`
DB_URL=jdbc:postgresql://postgres:5432/email_app
DB_USERNAME=email_user
DB_PASSWORD=email_password

# ---------------------------------------------------------------------
# Image coordinates (docker-compose.sample.yml and the Makefile)
# ---------------------------------------------------------------------
DOCKERHUB_USER=yourname
IMAGE_TAG=latest
HOST_PORT=8080

# ---------------------------------------------------------------------
# SMTP (optional - only used to seed the initial email configuration)
# ---------------------------------------------------------------------
# Generic SMTP example:
#   SMTP_HOST=smtp.example.com
#   SMTP_PORT=587
#   SMTP_USERNAME=my-user
#   SMTP_PASSWORD=my-password
#
# SendGrid SMTP example:
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@localhost
SMTP_FROM_NAME=Email Campaign Manager

# ---------------------------------------------------------------------
# Background worker (optional)
# APP_* variables map onto the app.* properties in application.properties
# and override them: underscores become dots, __ becomes _.
# ---------------------------------------------------------------------
APP_JOB_WORKER_ENABLED=true
APP_EMAIL_BATCH_SIZE=10
APP_EMAIL_DELAY_MS=1000
